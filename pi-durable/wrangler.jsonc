{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-durable-telegram-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PI_MODEL": "deepseek/deepseek-v4.1-flash-1017",
    "MEMORY_PREFIX": "hermes/",
    "WEB_SEARCH_PROVIDER": "exa"
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "AgentBackend" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentBackend"] }
  ],
  // Cloudflare Cron uses UTC: 00:00 UTC = 08:00 Asia/Shanghai the same day.
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true }
}
