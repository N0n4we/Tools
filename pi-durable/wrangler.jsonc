{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-durable-telegram-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PI_MODEL": "moonshotai/kimi-k3.1-pro",
    "MEMORY_PREFIX": "hermes/",
    "WEB_SEARCH_PROVIDER": "exa"
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "AgentBackend" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentBackend"] }
  ],
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
