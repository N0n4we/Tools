# Copy to .dev.vars for local use only; production values go in Workers Secrets.
TELEGRAM_BOT_TOKEN="replace-with-bot-token"
TELEGRAM_USER_ID="123456789"
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
OPENROUTER_API_KEY="replace-with-openrouter-key"
# Optional: select the matching WEB_SEARCH_PROVIDER in wrangler.jsonc.
# BRAVE_SEARCH_API_KEY="..."
# TAVILY_API_KEY="..."
# Optional non-secret TTS model (default shown; production uses wrangler vars).
# TTS_MODEL="bytedance-seed/seed-audio-1-0"
